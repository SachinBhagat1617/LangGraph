# ─────────────────────────────────────────────────────────────────────────────
# OCI GenAI Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your OCI credentials
#
# To get these values:
# 1. Log in to OCI Console → AI Services → Generative AI
# 2. Service Endpoint: The regional endpoint for GenAI (e.g., Chicago region)
# 3. Compartment ID: Your OCI compartment OCID
# 4. Model ID: The OCID of the model to use
# ─────────────────────────────────────────────────────────────────────────────

OCI_SERVICE_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your_compartment_id
OCI_MODEL_ID=your_model_id
